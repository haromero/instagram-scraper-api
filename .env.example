# Copia este archivo a .env y genera tus propios secretos.
IG_DATABASE_URL=sqlite:///./igscraper.db

# Documentación interactiva: déjalo en false en producción.
IG_DEBUG=false
# Publica /openapi.json sin /docs (necesario para importar el spec en RapidAPI).
IG_OPENAPI_ENABLED=false

# Genera el secreto JWT con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
IG_JWT_SECRET=
# Solo HS256, HS384 o HS512.
IG_JWT_ALGORITHM=HS256
IG_JWT_EXPIRES_SECONDS=900
IG_JWT_ISSUER=instagram-scraper-api
IG_JWT_AUDIENCE=instagram-scraper-clients
IG_JWT_LEEWAY_SECONDS=10

# Genera la clave Fernet con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IG_ENCRYPTION_KEY=

# El secreto en claro no se guarda: solo su hash PBKDF2.
#   python scripts/hash_secret.py
IG_CLIENT_ID=cli_abc123
IG_CLIENT_SECRET_HASH=

# Cliente de plataforma: único con admin:write.
IG_ADMIN_CLIENT_ID=cli_platform
IG_ADMIN_CLIENT_SECRET_HASH=

# Límites
IG_RATE_LIMIT_PER_MINUTE=600
IG_AUTH_RATE_LIMIT_PER_MINUTE=5
IG_JOBS_RATE_LIMIT_PER_MINUTE=10
# Cubo propio para /health/ready (no se cuenta como liveness barato).
IG_HEALTH_READY_RATE_LIMIT_PER_MINUTE=30
IG_REQUESTS_LIMIT=50000

# Estado compartido entre workers: memory (default, sin dependencias) o redis.
# Con redis se comparten rate limit, revocación de tokens y candados de cuota.
IG_RATE_LIMIT_BACKEND=memory
IG_REDIS_URL=redis://localhost:6379/0
IG_REDIS_TIMEOUT_SECONDS=1
# Si Redis cae: true = degradar el tráfico general; false = rechazar todo.
# /auth/token siempre es fail-closed para evitar fuerza bruta.
IG_RATE_LIMIT_FAIL_OPEN=true
# La revocación de JWT es fail-closed por defecto; las revocaciones hechas
# durante el corte se reintentan al recuperarse Redis.
IG_REVOCATION_FAIL_OPEN=false
IG_CONCURRENT_JOBS_LIMIT=10
# Cola de jobs: thread (default, en proceso) o redis (worker independiente).
# redis exige ademas IG_RATE_LIMIT_BACKEND=redis.
IG_JOB_BACKEND=thread
IG_JOB_QUEUE_STREAM=ig:jobs
IG_JOB_CONSUMER_GROUP=ig-jobs
IG_JOB_VISIBILITY_SECONDS=300
IG_JOB_MAX_ATTEMPTS=3
IG_JOB_POLL_SECONDS=1
IG_JOB_CLAIM_BATCH=10
# Webhooks: firma HMAC-SHA256 sobre "<timestamp>.<cuerpo>" (X-Signature).
# El secreto se genera al registrar el webhook si no se envía en la petición.
IG_WEBHOOK_TIMEOUT_SECONDS=5
IG_WEBHOOK_MAX_ATTEMPTS=3
IG_WEBHOOK_BACKOFF_SECONDS=1
# Presupuesto total compartido por todas las entregas de un mismo evento.
IG_WEBHOOK_DELIVERY_BUDGET_SECONDS=10
# Candado de cuota: TTL con heartbeat y tiempo máximo de espera por el lock.
IG_JOB_LOCK_TTL_SECONDS=10
IG_JOB_LOCK_TIMEOUT_SECONDS=2
IG_MAX_BODY_BYTES=1000000

# Red y despliegue
IG_CORS_ORIGINS=
IG_ALLOWED_HOSTS=127.0.0.1,localhost
# IPs o CIDR (CSV) de proxies de confianza. Solo entonces se lee
# X-Forwarded-For para el rate limit; vacío = se usa la IP del socket.
IG_TRUSTED_PROXIES=
IG_FORCE_HTTPS=false
IG_VALIDATE_OUTBOUND_DNS=true

# Simulación de scraping (segundos totales y número de pasos de progreso)
IG_JOB_SIMULATION_SECONDS=3
IG_JOB_STEPS=10

# Backend de datos: simulated (por defecto, sin red) o bluesky (datos reales)
IG_SCRAPER_BACKEND=simulated
# TTL de la caché de perfiles en segundos; 0 = sin caché
IG_PROFILE_CACHE_TTL_SECONDS=3600

# Bluesky / AT Protocol. Lecturas públicas sin credenciales.
IG_BLUESKY_API_BASE=https://public.api.bsky.app
IG_BLUESKY_APPVIEW_BASE=https://api.bsky.app
IG_BLUESKY_PDS_URL=https://bsky.social
IG_BLUESKY_TIMEOUT_SECONDS=20
IG_BLUESKY_MAX_RETRIES=3
IG_BLUESKY_BACKOFF_SECONDS=1

# Cuenta gratuita de Bluesky para operaciones autenticadas (opcional).
# La app password se genera en Bluesky > Settings > App Passwords.
# IG_BLUESKY_HANDLE=mi-cuenta.bsky.social
# IG_BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
